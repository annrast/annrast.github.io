<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page.url == "/" %}{{ site.title }}{% else %}{{ title }} | {{ site.title }}{% endif %}</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="noindex">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
{% if ogImage %}<meta property="og:image" content="{{ site.url }}{{ ogImage }}">{% endif %}
<link rel="icon" href="data:,">
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/text.css">
</head>
<body{% if theme %} class="theme-{{ theme }}"{% endif %}>
<div class="page"{% if canvasWidth %} style="max-width:{{ canvasWidth }}px"{% endif %}>
<header class="site-header">
  <a class="site-title" href="/">Ann Rast<br>Dolls &amp; Collectibles</a>
  <nav class="site-nav" aria-label="Main">
    <ul>
      <li><a href="/my-travels/">My Travels</a></li>
      <li><a href="/">Dolls For Sale</a></li>
    </ul>
  </nav>
</header>
<main id="content">
{{ content | safe }}
</main>
<footer class="site-footer">
  <p>Ann Rast Dolls &amp; Collectibles</p>
</footer>
</div>
</body>
</html>
