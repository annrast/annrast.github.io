---
layout: layout.njk
---
{%- set cat = categories | findCat(category) -%}
<p class="crumb"><a href="/">For Sale</a> › <a href="/for-sale/{{ cat.key }}/">{{ cat.title }}</a></p>
<article class="item">
  <div class="photo-main">
  {%- if photos and photos.length %}
    <img src="{{ photos[0] }}" {{ photos[0] | dims | safe }} alt="{{ title }}" fetchpriority="high" decoding="async">
  {%- else %}
    <div class="nophoto big">Photo coming soon</div>
  {%- endif %}
  </div>
  <div class="item-info">
    <h1>{{ title }}</h1>
    <p class="item-meta">
      {% if price %}<span class="price big">{{ price }}</span>{% endif %}
      <span class="badge badge-{{ status | slugStatus }}">{{ status }}</span>
    </p>
    {% if content | striptags | trim %}<div class="desc">{{ content | safe }}</div>{% endif %}
    {% if status != "Sold" %}
    <a class="btn" href="mailto:{{ site.email }}?subject={{ ('Question about: ' + title + (' (' + price + ')' if price else '')) | urlencode }}&amp;body={{ ('Hi Ann,\n\nI am interested in this item:\n' + title + '\n' + site.url + page.url + '\n\n') | urlencode }}">Ask about this item</a>
    <p class="small">Opens your email with the item name filled in. Prices do not include shipping. <a href="/about/#how-to-buy">How to buy</a></p>
    {% else %}
    <p>This item has been sold. <a href="/for-sale/{{ cat.key }}/">See what is still available in {{ cat.title }}</a>.</p>
    <a class="btn btn-ghost" href="mailto:{{ site.email }}?subject={{ ('Question about: ' + title + ' (sold)') | urlencode }}">Ask about this item</a>
    {% endif %}
  </div>
  {%- if photos and photos.length > 1 %}
  <div class="gallery">
    {%- for p in photos %}{% if not loop.first %}
    <img src="{{ p }}" {{ p | dims | safe }} alt="{{ title }} – photo {{ loop.index }}" loading="lazy" decoding="async">
    {%- endif %}{% endfor %}
  </div>
  {%- endif %}
</article>
