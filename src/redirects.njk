# Cloudflare Pages redirects: every URL of the old iWeb site → its new home (301).
# Paths are case-sensitive and matched against the raw request path, so these lines cover
# the literal-"&" form browsers send. Percent-encoded "%26" forms can't be matched here;
# _routes.json sends just those to functions/[[path]].js, which uses the same map.
/index.html  /  301
/Ann_Rast_Dolls_&_Collectibles  /  301
/Ann_Rast_Dolls_&_Collectibles/  /  301
/Ann_Rast_Dolls_&_Collectibles/index.html  /  301
/Ann_Rast_Dolls_&_Collectibles/feed.xml  /feed.xml  301
{%- for r in legacy %}
{{ r.old | redirectPath | safe }}  {{ r.new }}  301
{%- endfor %}
